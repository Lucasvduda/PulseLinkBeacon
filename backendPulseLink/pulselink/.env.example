# Copie este arquivo para ".env" (mesma pasta) e ajuste o valor.
# O .env NUNCA deve ser commitado (já está no .gitignore).

# Chave usada para assinar os tokens JWT. Use pelo menos 32 caracteres aleatórios.
JWT_SECRET=defina-uma-chave-secreta-com-pelo-menos-32-caracteres

# Tempo de expiração do token em milissegundos (86400000 = 24 horas)
JWT_EXPIRATION=86400000
